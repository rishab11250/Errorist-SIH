# Backend Environment Configuration
LMPC_SESSION_HOURS=8
LMPC_COOKIE_SECURE=false
LMPC_COOKIE_NAME=lmpc_session
LMPC_MAX_UPLOAD_BYTES=10000000
LMPC_MAX_IMAGE_PIXELS=24000000
LMPC_MAX_OCR_WORDS=2104
LMPC_DB_PATH=lmpc.db
LMPC_BACKEND_ORIGIN=http://127.0.0.1:8000
LMPC_ALLOWED_BROWSER_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Development only: Allow ngrok/tunnel domains and LAN IPs for phone testing.
# MUST BE FALSE IN PRODUCTION.
LMPC_ALLOW_TUNNEL_ORIGINS=false
